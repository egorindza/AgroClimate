@inject AgroClimate.Application.Interfaces.ITelemetryChannel TelemetryChannel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var roleKey = User.GetRoleKey();
    var fullName = User.GetFullName();
    var roleTitle = User.GetRoleTitle();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var pipeMetrics = TelemetryChannel.GetMetrics();
}
<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AgroClimate War Room | ИрГАУ</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("agroclimate-theme") || "dark";
                document.documentElement.setAttribute("data-theme", saved);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="mc-navbar">
        <div style="max-width:1520px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:0.9rem;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
                <a href="/" class="mc-brand">
                    <span class="mc-brand-mark">AC</span>
                    <span>
                        AgroClimate War Room
                        <span class="mc-brand-sub">ИрГАУ им. А.А. Ежевского • Телеметрия Сибири</span>
                    </span>
                </a>

                <nav class="mc-nav-links">
                    <a href="/" class="mc-nav-link @(currentController == "Dashboard" ? "active" : "")">
                        <span>🛰</span> Карта объектов
                    </a>
                    <a href="/Incidents" class="mc-nav-link @(currentController == "Incidents" ? "active" : "")">
                        <span>🚨</span> Incident War Room
                    </a>
                    <a href="/Profiles" class="mc-nav-link @(currentController == "Profiles" ? "active" : "")">
                        <span>🌱</span> Агро-профили
                    </a>
                    <a href="/Analytics" class="mc-nav-link @(currentController == "Analytics" ? "active" : "")">
                        <span>📈</span> Аналитика и SLA
                    </a>
                    <a href="/ApiKeys" class="mc-nav-link @(currentController == "ApiKeys" ? "active" : "")">
                        <span>🔌</span> ESP32 / API
                    </a>
                </nav>
            </div>

            <div style="display:flex;align-items:center;gap:0.65rem;flex-wrap:wrap;">
                <div class="mc-pipeline-pill tabular" title="Потоковый конвейер: System.Threading.Channels → SqlBulkCopy → Columnstore Index → SignalR">
                    <span id="sr-conn-dot" class="status-dot optimal"></span>
                    <span id="sr-conn-text" style="font-weight:700;">SignalR Live</span>
                    <span style="opacity:0.4;">|</span>
                    <span>Columnstore: <strong id="pipe-total-rows">@(pipeMetrics.ColumnstoreTotalRows > 0 ? pipeMetrics.ColumnstoreTotalRows.ToString("N0") : "—")</strong></span>
                    <span style="opacity:0.4;">|</span>
                    <span>Bulk: <strong id="pipe-flush-ms">1.4 мс</strong></span>
                </div>

                <!-- Демо-переключатель ролей в 1 клик -->
                <div style="display:inline-flex;align-items:center;gap:0.35rem;background:var(--bg-surface-muted);border:1px solid var(--border-subtle);border-radius:9px;padding:0.22rem 0.4rem;">
                    <form method="post" action="/Auth/SwitchRole" style="margin:0;display:inline;">
                        <input type="hidden" name="roleKey" value="@DemoRoles.ChiefAgronomist" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="mc-btn mc-btn-sm @(roleKey == DemoRoles.ChiefAgronomist ? "mc-btn-primary" : "")" title="Главный агроном / Научный руководитель (полный доступ)">Агроном</button>
                    </form>
                    <form method="post" action="/Auth/SwitchRole" style="margin:0;display:inline;">
                        <input type="hidden" name="roleKey" value="@DemoRoles.ShiftEngineer" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="mc-btn mc-btn-sm @(roleKey == DemoRoles.ShiftEngineer ? "mc-btn-primary" : "")" title="Дежурный инженер КИПиА (War Room + ESP32 API)">КИПиА</button>
                    </form>
                    <form method="post" action="/Auth/SwitchRole" style="margin:0;display:inline;">
                        <input type="hidden" name="roleKey" value="@DemoRoles.LabAssistant" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="mc-btn mc-btn-sm @(roleKey == DemoRoles.LabAssistant ? "mc-btn-primary" : "")" title="Лаборант биолаборатории">Лаборант</button>
                    </form>
                    <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(returnUrl)" class="mc-btn mc-btn-sm" title="@fullName — @roleTitle" style="border-style:dashed;">
                        👤 @fullName
                    </a>
                </div>

                <button type="button" onclick="toggleMcTheme()" class="mc-btn mc-btn-sm" title="Переключить темную/светлую тему диспетчерской">
                    <span id="mc-theme-btn-label">☀ Светлая</span>
                </button>
            </div>
        </div>
    </header>

    <main class="mc-container">
        @RenderBody()
    </main>

    <footer style="border-top:1px solid var(--border-subtle);padding:0.9rem 1.35rem;text-align:center;color:var(--text-muted);font-size:0.78rem;">
        АИС «AgroClimate War Room» • Портфолио-система телеметрии микроклимата ИрГАУ и агропредприятий Сибири •
        <code>Channels → SqlBulkCopy → Columnstore + Temporal Tables + T-SQL Window Functions + SignalR + HTMX</code>
    </footer>

    <div id="mc-toast-container"></div>

    <script src="~/vendor/htmx.min.js" asp-append-version="true"></script>
    <script src="~/vendor/signalr.min.js" asp-append-version="true"></script>
    <script src="~/vendor/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
