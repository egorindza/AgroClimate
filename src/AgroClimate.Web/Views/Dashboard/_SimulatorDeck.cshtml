@model SimulatorStatusDto

<div class="mc-card" style="margin-bottom:1.15rem;border-color:rgba(6, 182, 212, 0.35);">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.8rem;flex-wrap:wrap;">
        <div>
            <div style="display:flex;align-items:center;gap:0.55rem;flex-wrap:wrap;">
                <span class="mc-badge mc-badge-info">🎛 ВСТРОЕННЫЙ C# IoT-СИМУЛЯТОР ТЕЛЕМЕТРИИ</span>
                <span class="mc-badge @(Model.IsRunning ? "mc-badge-optimal" : "mc-badge-warning")">
                    @(Model.IsRunning ? "ГЕНЕРАЦИЯ АКТИВНА (2.0 С)" : "НА ПАУЗЕ")
                </span>
                <span style="font-size:0.82rem;color:var(--text-secondary);">
                    Режим: <strong id="sim-active-title" style="color:var(--text-primary);">@Model.ScenarioTitle</strong>
                </span>
            </div>
            <div style="font-size:0.81rem;color:var(--text-secondary);margin-top:0.25rem;">
                @Model.ScenarioDescription
            </div>
        </div>

        <form hx-post="/Dashboard/ToggleSimulator" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/ToggleSimulator" style="margin:0;">
            <button type="submit" class="mc-btn @(Model.IsRunning ? "" : "mc-btn-primary")">
                @(Model.IsRunning ? "⏸ Пауза потока" : "▶ Возобновить поток")
            </button>
        </form>
    </div>

    <div class="sim-grid">
        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.NormalOperation" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.NormalOperation ? "active-normal" : "")">
                <div style="font-weight:700;font-size:0.86rem;color:var(--accent-emerald);">✅ 1. Штатная работа всех объектов</div>
                <div style="font-size:0.76rem;color:var(--text-secondary);margin-top:0.2rem;">
                    Стабилизация ПИД-контуров всех 5 зон ИрГАУ и восстановление связи контроллеров.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.IrkutskFrostHeatingFailure" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.IrkutskFrostHeatingFailure ? "active-danger" : "")">
                <div style="font-weight:700;font-size:0.86rem;color:var(--accent-red);">❄️ 2. Ночной заморозок (-36°C) • Теплица №1</div>
                <div style="font-size:0.76rem;color:var(--text-secondary);margin-top:0.2rem;">
                    Отказ контура обогрева рассады томата: стремительное падение T°, скачок RH% и роса.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.GrainSiloSelfHeating" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.GrainSiloSelfHeating ? "active-danger" : "")">
                <div style="font-weight:700;font-size:0.86rem;color:var(--accent-amber);">🔥 3. Очаг самосогревания • Силос пшеницы №2</div>
                <div style="font-size:0.76rem;color:var(--text-secondary);margin-top:0.2rem;">
                    Биологический разогрев зерновой массы, рост межзерновой влажности и скачок CO₂ &gt; 2000 ppm.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.PotatoStorageDeadMansSwitch" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.PotatoStorageDeadMansSwitch ? "active-danger" : "")">
                <div style="font-weight:700;font-size:0.86rem;color:#c084fc;">📡 4. Обрыв связи контроллера • Овощехранилище</div>
                <div style="font-size:0.76rem;color:var(--text-secondary);margin-top:0.2rem;">
                    Зависание ESP32-POTATO-03 и автоматическое срабатывание сторожа Dead Man's Switch (~10 с).
                </div>
            </button>
        </form>
    </div>
</div>
