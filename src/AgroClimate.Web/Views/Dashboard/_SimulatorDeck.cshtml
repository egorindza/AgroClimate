@model SimulatorStatusDto

<div class="panel">
    <div class="section-heading mb-2">
        <div>
            <p class="eyebrow">Управляемый стенд живого демо</p>
            <h2>Встроенный C# IoT-симулятор сценариев ИрГАУ</h2>
            <p class="mt-1">
                Активный режим: <strong id="sim-active-title" style="color:var(--agro-text);">@Model.ScenarioTitle</strong>
                — @Model.ScenarioDescription
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="agro-badge @(Model.IsRunning ? "" : "agro-badge-warn")">
                @(Model.IsRunning ? "Генерация активна (2.0 с)" : "На паузе")
            </span>
            <form hx-post="/Dashboard/ToggleSimulator" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/ToggleSimulator" style="margin:0;">
                <button type="submit" class="btn btn-sm @(Model.IsRunning ? "btn-outline-secondary" : "btn-primary")">
                    @(Model.IsRunning ? "⏸ Пауза потока" : "▶ Возобновить поток")
                </button>
            </form>
        </div>
    </div>

    <div class="sim-grid">
        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.NormalOperation" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.NormalOperation ? "active-normal" : "")">
                <div style="font-weight:700;font-size:.9rem;color:var(--agro-primary);">1. Штатная работа всех объектов</div>
                <div class="small text-muted mt-1">
                    Стабилизация ПИД-контуров всех 5 зон ИрГАУ и восстановление штатной связи контроллеров.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.IrkutskFrostHeatingFailure" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.IrkutskFrostHeatingFailure ? "active-danger" : "")">
                <div style="font-weight:700;font-size:.9rem;color:var(--agro-danger);">2. Ночной заморозок (-36°C) · Теплица №1</div>
                <div class="small text-muted mt-1">
                    Отказ контура обогрева рассады томата: стремительное падение T°, скачок RH% и точка росы.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.GrainSiloSelfHeating" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.GrainSiloSelfHeating ? "active-danger" : "")">
                <div style="font-weight:700;font-size:.9rem;color:#b45309;">3. Очаг самосогревания · Силос пшеницы №2</div>
                <div class="small text-muted mt-1">
                    Биологический разогрев зерновой массы, рост межзерновой влажности и скачок CO₂ &gt; 2000 ppm.
                </div>
            </button>
        </form>

        <form hx-post="/Dashboard/SetScenario" hx-target="#simulator-deck-host" hx-swap="innerHTML" method="post" action="/Dashboard/SetScenario" style="margin:0;">
            <input type="hidden" name="scenario" value="@SimulationScenario.PotatoStorageDeadMansSwitch" />
            <button type="submit" class="sim-btn @(Model.ActiveScenario == SimulationScenario.PotatoStorageDeadMansSwitch ? "active-danger" : "")">
                <div style="font-weight:700;font-size:.9rem;color:#1d4ed8;">4. Обрыв связи контроллера · Овощехранилище</div>
                <div class="small text-muted mt-1">
                    Зависание ESP32-POTATO-03 и автоматическое срабатывание сторожа Dead Man's Switch.
                </div>
            </button>
        </form>
    </div>
</div>
