@model DashboardViewModel

@if (Model.Zones.Count == 0)
{
    <div class="panel empty-state">
        <strong>Нет объектов, соответствующих выбранному фильтру</strong>
        <span>Переключите вкладку на «Все объекты (5)», чтобы отобразить полную карту телеметрии ИрГАУ.</span>
    </div>
}
else
{
    <div class="zones-grid">
        @foreach (var zone in Model.Zones)
        {
            var p = zone.AgroProfile;
            Model.ActiveIncidentByZone.TryGetValue(zone.Id, out var activeInc);

            string cardClass = !zone.IsSensorOnline || zone.CurrentComplianceState == ComplianceState.Offline
                ? "panel mc-card-offline"
                : zone.CurrentComplianceState == ComplianceState.Critical
                    ? "panel mc-card-critical"
                    : zone.CurrentComplianceState == ComplianceState.Warning
                        ? "panel mc-card-warning"
                        : "panel";

            string dotClass = !zone.IsSensorOnline || zone.CurrentComplianceState == ComplianceState.Offline
                ? "status-dot offline"
                : zone.CurrentComplianceState == ComplianceState.Critical
                    ? "status-dot critical"
                    : zone.CurrentComplianceState == ComplianceState.Warning
                        ? "status-dot warning"
                        : "status-dot optimal";

            string badgeClass = !zone.IsSensorOnline || zone.CurrentComplianceState >= ComplianceState.Critical
                ? "agro-badge agro-badge-danger"
                : zone.CurrentComplianceState == ComplianceState.Warning
                    ? "agro-badge agro-badge-warn"
                    : "agro-badge";

            string badgeText = !zone.IsSensorOnline || zone.CurrentComplianceState == ComplianceState.Offline
                ? "Обрыв связи"
                : zone.CurrentComplianceState == ComplianceState.Critical
                    ? "Критическая тревога"
                    : zone.CurrentComplianceState == ComplianceState.Warning
                        ? "Отклонение / тренд"
                        : "В норме";

            var irkutskTime = zone.LastTelemetryUtc?.AddHours(8).ToString("HH:mm:ss") ?? "—";

            <article class="@cardClass" data-zone-card="@zone.Id">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <p class="card-kicker mb-1">@zone.Code · @zone.AreaOrVolume @zone.AreaUnit</p>
                        <div class="d-flex align-items-center gap-2">
                            <span data-zone-dot class="@dotClass"></span>
                            <h3 class="h5 mb-0 fw-bold">@zone.Name</h3>
                        </div>
                        <div class="small text-muted mt-1">
                            @zone.LocationCampus · <code>@zone.ControllerNodeId</code>
                        </div>
                    </div>
                    <span data-zone-badge class="@badgeClass">@badgeText</span>
                </div>

                @if (p is not null)
                {
                    <div class="mt-2 p-2 rounded" style="background:var(--agro-surface-alt);border:1px solid var(--agro-border);font-size:.81rem;display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap;">
                        <span><strong>@p.CropName</strong> <span class="text-muted">(@p.GrowthStage)</span></span>
                        <span class="tabular fw-semibold" style="color:var(--agro-primary);">
                            Норма: @p.TargetTempMin.ToString("F1")..@p.TargetTempMax.ToString("F1") °C
                        </span>
                    </div>
                }

                <div class="metric-matrix tabular">
                    <div class="metric-cell">
                        <div class="metric-cell-label">Темп. T°</div>
                        <div class="metric-cell-val" data-val-temp>@zone.CurrentTempC.ToString("F1")</div>
                        <div class="metric-cell-unit">°C</div>
                    </div>
                    <div class="metric-cell">
                        <div class="metric-cell-label">Влажн. RH</div>
                        <div class="metric-cell-val" data-val-hum>@zone.CurrentHumidityPercent.ToString("F1")</div>
                        <div class="metric-cell-unit">%</div>
                    </div>
                    <div class="metric-cell">
                        <div class="metric-cell-label">CO₂</div>
                        <div class="metric-cell-val" data-val-co2>@zone.CurrentCo2Ppm.ToString("F0")</div>
                        <div class="metric-cell-unit">ppm</div>
                    </div>
                    <div class="metric-cell" title="Точка росы (формула Магнуса–Тетенса)">
                        <div class="metric-cell-label">Точка росы</div>
                        <div class="metric-cell-val" data-val-dp>@zone.CurrentDewPointC.ToString("F1")</div>
                        <div class="metric-cell-unit">°C T<sub>dp</sub></div>
                    </div>
                    <div class="metric-cell" title="Дефицит упругости водяного пара (Vapor Pressure Deficit)">
                        <div class="metric-cell-label">VPD</div>
                        <div class="metric-cell-val" data-val-vpd>@zone.CurrentVpdKpa.ToString("F2")</div>
                        <div class="metric-cell-unit">кПа</div>
                    </div>
                </div>

                <div class="small text-muted" style="min-height:2.2em;" data-val-note>
                    @zone.StatusNote
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-2" style="border-top:1px solid var(--agro-border);">
                    <div class="small text-muted tabular">
                        Тренд: <strong data-val-vel>@(zone.CurrentTempVelocityPerMin >= 0 ? "+" : "")@zone.CurrentTempVelocityPerMin.ToString("F2") °C/мин</strong>
                        · <span data-val-time>@irkutskTime</span>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span data-warroom-slot>
                            @if (activeInc is not null)
                            {
                                <a href="/Incidents/WarRoom/@activeInc.Id" class="btn btn-danger btn-sm">War Room #@activeInc.Id</a>
                            }
                        </span>
                        <a href="/Analytics?zoneId=@zone.Id&hours=6" class="btn btn-outline-primary btn-sm">Ряды и тренды</a>
                        <a href="/Profiles?id=@zone.AgroProfileId" class="btn btn-outline-secondary btn-sm">Нормы</a>
                    </div>
                </div>
            </article>
        }
    </div>
}
