@model IReadOnlyList<AgroProfileTemporalHistoryDto>

<div class="table-responsive" style="max-height:420px;">
    <table id="temporalAuditTable" class="table table-sticky tabular">
        <thead>
            <tr>
                <th>Статус ревизии</th>
                <th>Культура / Фаза</th>
                <th>Целевой T°</th>
                <th>Крит. T°</th>
                <th>Влажность RH</th>
                <th>Крит. CO₂</th>
                <th>Grace / Запас</th>
                <th>Кто утвердил</th>
                <th>Период действия (ИРК)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>
                        @if (row.IsCurrent)
                        {
                            <span class="agro-badge">Актуальная</span>
                        }
                        else
                        {
                            <span class="agro-badge agro-badge-info">Архив History</span>
                        }
                    </td>
                    <td>
                        <strong>@row.CropName</strong><br />
                        <small class="text-muted">@row.GrowthStage</small>
                    </td>
                    <td class="fw-bold" style="color:var(--agro-primary);">
                        @row.TargetTempMin.ToString("F1")..@row.TargetTempMax.ToString("F1") °C
                    </td>
                    <td style="color:var(--agro-danger);">
                        @row.CritTempMin.ToString("F1") / @row.CritTempMax.ToString("F1") °C
                    </td>
                    <td>@row.TargetHumidityMin.ToString("F0")..@row.TargetHumidityMax.ToString("F0") %</td>
                    <td>@row.CritCo2Max.ToString("F0") ppm</td>
                    <td>@row.GracePeriodSeconds с / @row.BaseTimeToDamageMinutes мин</td>
                    <td class="fw-semibold">@row.LastModifiedBy</td>
                    <td class="small text-nowrap">
                        <div>с @row.ValidFromUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss")</div>
                        @if (!row.IsCurrent)
                        {
                            <div class="text-muted">до @row.ValidToUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss")</div>
                        }
                        else
                        {
                            <div style="color:var(--agro-primary);">по настоящее время</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
