@using System.Globalization
@model ProfilesViewModel
@{
    ViewData["Title"] = "Конструктор агро-профилей норм";
    var f = Model.EditForm;
    bool canEdit = User.CanEditAgroProfiles();
    string Inv(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}

<header class="page-header">
    <div>
        <p class="eyebrow">Нормативные коридоры и системное версионирование</p>
        <h1>Конструктор агро-профилей культур ИрГАУ</h1>
        <p class="page-description">Настраивайте целевые коридоры температуры, влажности, CO₂ и дефицита упругости пара (VPD), пороги предупреждения, Grace Period и чек-листы экстренного реагирования с неизменяемым аудитом в MS SQL Server Temporal Tables.</p>
    </div>
    <div class="header-actions">
        <span class="agro-badge">SYSTEM_VERSIONING = ON</span>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.SavedBannerMessage))
{
    <div class="alert alert-success" role="status">@Model.SavedBannerMessage</div>
}

@if (Model.ValidationErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>Ошибка проверки агрономических коридоров (FluentValidation):</strong>
        <ul class="mb-0 mt-1">
            @foreach (var err in Model.ValidationErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<div class="row g-3 align-items-start">
    <!-- Список культур ИрГАУ -->
    <div class="col-lg-3">
        <div class="panel p-3">
            <p class="eyebrow mb-2">Справочник профилей (5)</p>
            @foreach (var p in Model.Profiles)
            {
                bool active = p.Id == Model.SelectedProfile.Id;
                <a href="/Profiles?id=@p.Id"
                   class="d-block p-2 px-3 rounded mb-2"
                   style="border:1px solid @(active ? "var(--agro-primary)" : "var(--agro-border)");background:@(active ? "var(--agro-badge-bg)" : "var(--agro-surface-alt)");color:var(--agro-text);">
                    <div class="fw-bold" style="font-size:.88rem;">@p.CropName</div>
                    <div class="small text-muted">@p.GrowthStage</div>
                    <div class="small tabular fw-semibold mt-1" style="color:var(--agro-primary);">
                        T°: @p.TargetTempMin.ToString("F1")..@p.TargetTempMax.ToString("F1") °C · RH: @p.TargetHumidityMin.ToString("F0")..@p.TargetHumidityMax.ToString("F0")%
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- Редактор выбранного профиля -->
    <div class="col-lg-9">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <span class="agro-badge">@Model.SelectedProfile.Code</span>
                    <span class="small text-muted ms-2">
                        Автор актуальной ревизии: <strong>@Model.SelectedProfile.LastModifiedBy</strong>
                    </span>
                </div>
                @if (!canEdit)
                {
                    <span class="agro-badge agro-badge-warn">Режим чтения · переключите роль на «Агроном» слева внизу для сохранения</span>
                }
            </div>

            <div class="p-3 rounded mb-3" style="background:var(--agro-surface-alt);border:1px solid var(--agro-border);">
                <div class="d-flex justify-content-between small fw-bold tabular">
                    <span style="color:var(--agro-danger);">Крит. мин: @f.CritTempMin°C</span>
                    <span style="color:#b45309;">Warn: @f.WarnTempMin°C</span>
                    <span style="color:var(--agro-primary);">Целевой оптимум: @f.TargetTempMin..@f.TargetTempMax °C</span>
                    <span style="color:#b45309;">Warn: @f.WarnTempMax°C</span>
                    <span style="color:var(--agro-danger);">Крит. макс: @f.CritTempMax°C</span>
                </div>
                <div class="corridor-bar">
                    <div class="corridor-seg-crit"></div>
                    <div class="corridor-seg-warn"></div>
                    <div class="corridor-seg-opt"></div>
                    <div class="corridor-seg-warn"></div>
                    <div class="corridor-seg-crit"></div>
                </div>
            </div>

            <form method="post" action="/Profiles/Update">
                <input type="hidden" name="Id" value="@f.Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Наименование культуры / объекта хранения</label>
                        <input type="text" name="CropName" class="form-control" value="@f.CropName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Фаза вегетации / режим хранения</label>
                        <input type="text" name="GrowthStage" class="form-control" value="@f.GrowthStage" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Агрономическое обоснование (научное примечание ИрГАУ)</label>
                        <input type="text" name="ScientificNotes" class="form-control" value="@f.ScientificNotes" />
                    </div>
                </div>

                <p class="eyebrow mt-3 mb-2">1. Коридор температуры воздуха / насыпи (°C)</p>
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Мин</label><input type="number" step="0.1" name="CritTempMin" class="form-control tabular" value="@Inv(f.CritTempMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Мин</label><input type="number" step="0.1" name="WarnTempMin" class="form-control tabular" value="@Inv(f.WarnTempMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Мин</label><input type="number" step="0.1" name="TargetTempMin" class="form-control tabular" value="@Inv(f.TargetTempMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Макс</label><input type="number" step="0.1" name="TargetTempMax" class="form-control tabular" value="@Inv(f.TargetTempMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Макс</label><input type="number" step="0.1" name="WarnTempMax" class="form-control tabular" value="@Inv(f.WarnTempMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Макс</label><input type="number" step="0.1" name="CritTempMax" class="form-control tabular" value="@Inv(f.CritTempMax)" /></div>
                </div>

                <p class="eyebrow mt-3 mb-2">2. Относительная влажность воздуха RH (%)</p>
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Мин</label><input type="number" step="0.5" name="CritHumidityMin" class="form-control tabular" value="@Inv(f.CritHumidityMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Мин</label><input type="number" step="0.5" name="WarnHumidityMin" class="form-control tabular" value="@Inv(f.WarnHumidityMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Мин</label><input type="number" step="0.5" name="TargetHumidityMin" class="form-control tabular" value="@Inv(f.TargetHumidityMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Макс</label><input type="number" step="0.5" name="TargetHumidityMax" class="form-control tabular" value="@Inv(f.TargetHumidityMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Макс</label><input type="number" step="0.5" name="WarnHumidityMax" class="form-control tabular" value="@Inv(f.WarnHumidityMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Макс</label><input type="number" step="0.5" name="CritHumidityMax" class="form-control tabular" value="@Inv(f.CritHumidityMax)" /></div>
                </div>

                <p class="eyebrow mt-3 mb-2">3. Дефицит упругости водяного пара VPD (кПа)</p>
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Мин</label><input type="number" step="0.01" name="CritVpdMin" class="form-control tabular" value="@Inv(f.CritVpdMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Мин</label><input type="number" step="0.01" name="WarnVpdMin" class="form-control tabular" value="@Inv(f.WarnVpdMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Мин</label><input type="number" step="0.01" name="TargetVpdMin" class="form-control tabular" value="@Inv(f.TargetVpdMin)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Норма Макс</label><input type="number" step="0.01" name="TargetVpdMax" class="form-control tabular" value="@Inv(f.TargetVpdMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Warn Макс</label><input type="number" step="0.01" name="WarnVpdMax" class="form-control tabular" value="@Inv(f.WarnVpdMax)" /></div>
                    <div class="col-6 col-md-2"><label class="form-label small">Крит. Макс</label><input type="number" step="0.01" name="CritVpdMax" class="form-control tabular" value="@Inv(f.CritVpdMax)" /></div>
                </div>

                <p class="eyebrow mt-3 mb-2">4. Газовый режим CO₂, точка росы, тренды и Grace Period</p>
                <div class="row g-2 mb-2">
                    <div class="col-6 col-md-3"><label class="form-label small">CO₂ Норма Мин (ppm)</label><input type="number" step="10" name="TargetCo2Min" class="form-control tabular" value="@Inv(f.TargetCo2Min)" /></div>
                    <div class="col-6 col-md-3"><label class="form-label small">CO₂ Норма Макс (ppm)</label><input type="number" step="10" name="TargetCo2Max" class="form-control tabular" value="@Inv(f.TargetCo2Max)" /></div>
                    <div class="col-6 col-md-3"><label class="form-label small">CO₂ Warn Макс (ppm)</label><input type="number" step="10" name="WarnCo2Max" class="form-control tabular" value="@Inv(f.WarnCo2Max)" /></div>
                    <div class="col-6 col-md-3"><label class="form-label small">CO₂ Крит. Макс (ppm)</label><input type="number" step="10" name="CritCo2Max" class="form-control tabular" value="@Inv(f.CritCo2Max)" /></div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md"><label class="form-label small">Запас T−T<sub>dp</sub> (°C)</label><input type="number" step="0.1" name="MinDewPointSpreadC" class="form-control tabular" value="@Inv(f.MinDewPointSpreadC)" /></div>
                    <div class="col-6 col-md"><label class="form-label small">Макс спад (°C/мин)</label><input type="number" step="0.05" name="MaxAllowedTempDropRatePerMin" class="form-control tabular" value="@Inv(f.MaxAllowedTempDropRatePerMin)" /></div>
                    <div class="col-6 col-md"><label class="form-label small">Макс рост (°C/мин)</label><input type="number" step="0.05" name="MaxAllowedTempRiseRatePerMin" class="form-control tabular" value="@Inv(f.MaxAllowedTempRiseRatePerMin)" /></div>
                    <div class="col-6 col-md"><label class="form-label small">Grace Period (с)</label><input type="number" step="1" name="GracePeriodSeconds" class="form-control tabular" value="@f.GracePeriodSeconds" /></div>
                    <div class="col-6 col-md"><label class="form-label small">Запас выживания (мин)</label><input type="number" step="1" name="BaseTimeToDamageMinutes" class="form-control tabular" value="@f.BaseTimeToDamageMinutes" /></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Шаги аварийного регламента для War Room (разделитель «|»)</label>
                    <textarea name="EmergencyPlaybookSteps" class="form-control" rows="3">@f.EmergencyPlaybookSteps</textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary" @(canEdit ? "" : "disabled")>
                        Сохранить профиль и зафиксировать ревизию в Temporal Table
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Секция системного аудита MS SQL Server Temporal Tables -->
<section class="dashboard-section panel">
    <div class="section-heading mb-3">
        <div>
            <p class="eyebrow">Неизменяемая история ревизий</p>
            <h2>Журнал аудита Temporal Table (<code>FOR SYSTEM_TIME ALL</code>)</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <input type="search" class="form-control form-control-sm" style="width:230px;"
                   placeholder="Фильтр по автору или культуре…"
                   data-table-filter="temporalAuditTable" />
            <button type="button" class="btn btn-primary btn-sm"
                    hx-get="/Profiles/HistoryPartial?profileId=@Model.SelectedProfile.Id"
                    hx-target="#temporal-history-host"
                    hx-swap="innerHTML">
                Текущая культура
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm"
                    hx-get="/Profiles/HistoryPartial"
                    hx-target="#temporal-history-host"
                    hx-swap="innerHTML">
                Все культуры ИрГАУ
            </button>
        </div>
    </div>

    <div id="temporal-history-host">
        @await Html.PartialAsync("_TemporalHistoryTable", Model.TemporalHistory)
    </div>
</section>
