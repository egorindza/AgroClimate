@using System.Globalization
@model ProfilesViewModel
@{
    ViewData["Title"] = "Конструктор агро-профилей норм";
    var f = Model.EditForm;
    bool canEdit = User.CanEditAgroProfiles();
    string Inv(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}

<div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
    <div>
        <h1 style="margin:0;font-size:1.28rem;font-weight:800;">🌱 Конструктор агрономических профилей норм ИрГАУ</h1>
        <div style="font-size:0.82rem;color:var(--text-secondary);">
            Настройка целевых коридоров, Grace Period и аварийных регламентов • Системное версионирование MS SQL Server <code>SYSTEM_VERSIONING = ON</code>
        </div>
    </div>
    <span class="mc-badge mc-badge-optimal">Temporal History Active (dbo.AgroProfilesHistory)</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SavedBannerMessage))
{
    <div class="mc-card" style="margin-bottom:1rem;border-color:var(--accent-emerald);padding:0.8rem 1rem;color:var(--accent-emerald);font-weight:600;">
        ✅ @Model.SavedBannerMessage
    </div>
}

@if (Model.ValidationErrors.Count > 0)
{
    <div class="mc-card mc-card-critical" style="margin-bottom:1rem;padding:0.85rem 1.1rem;">
        <div style="font-weight:800;color:var(--accent-red);margin-bottom:0.3rem;">Ошибка проверки агрономических коридоров (FluentValidation):</div>
        <ul style="margin:0;padding-left:1.2rem;color:var(--text-primary);font-size:0.85rem;">
            @foreach (var err in Model.ValidationErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<div style="display:grid;grid-template-columns:310px 1fr;gap:1.1rem;align-items:start;">
    <!-- Список культур ИрГАУ -->
    <div class="mc-card" style="padding:0.8rem;">
        <div style="font-size:0.75rem;text-transform:uppercase;color:var(--text-secondary);font-weight:700;padding:0.2rem 0.4rem 0.55rem;">
            Профили культур (5)
        </div>
        @foreach (var p in Model.Profiles)
        {
            bool active = p.Id == Model.SelectedProfile.Id;
            <a href="/Profiles?id=@p.Id"
               style="display:block;padding:0.68rem 0.75rem;border-radius:10px;margin-bottom:0.4rem;border:1px solid @(active ? "var(--accent-emerald)" : "var(--border-subtle)");background:@(active ? "var(--accent-emerald-soft)" : "var(--bg-surface-muted)");color:var(--text-primary);">
                <div style="font-weight:700;font-size:0.87rem;">@p.CropName</div>
                <div style="font-size:0.74rem;color:var(--text-secondary);">@p.GrowthStage</div>
                <div class="tabular" style="font-size:0.74rem;color:var(--accent-emerald);margin-top:0.2rem;">
                    T°: @p.TargetTempMin.ToString("F1")..@p.TargetTempMax.ToString("F1")°C • RH: @p.TargetHumidityMin.ToString("F0")..@p.TargetHumidityMax.ToString("F0")%
                </div>
            </a>
        }
    </div>

    <!-- Редактор выбранного профиля -->
    <div class="mc-card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
            <div>
                <span class="mc-badge mc-badge-info">@Model.SelectedProfile.Code</span>
                <span style="font-size:0.78rem;color:var(--text-secondary);margin-left:0.4rem;">
                    Последнее изменение: <strong>@Model.SelectedProfile.LastModifiedBy</strong>
                </span>
            </div>
            @if (!canEdit)
            {
                <span class="mc-badge mc-badge-warning">Только чтение (переключите роль на «Агроном» в шапке для сохранения)</span>
            }
        </div>

        <!-- Наглядная шкала коридоров безопасности -->
        <div style="padding:0.7rem 0.85rem;border-radius:10px;background:var(--bg-surface-muted);margin-bottom:1rem;">
            <div style="display:flex;justify-content:space-between;font-size:0.75rem;font-weight:700;" class="tabular">
                <span style="color:var(--accent-red);">Крит. мин: @f.CritTempMin°C</span>
                <span style="color:var(--accent-amber);">Warn: @f.WarnTempMin°C</span>
                <span style="color:var(--accent-emerald);">Целевой оптимум: @f.TargetTempMin..@f.TargetTempMax °C</span>
                <span style="color:var(--accent-amber);">Warn: @f.WarnTempMax°C</span>
                <span style="color:var(--accent-red);">Крит. макс: @f.CritTempMax°C</span>
            </div>
            <div class="corridor-bar">
                <div class="corridor-seg-crit" title="Критическое переохлаждение"></div>
                <div class="corridor-seg-warn" title="Предупредительный буфер охлаждения"></div>
                <div class="corridor-seg-opt" title="Целевой зеленый агрономический коридор"></div>
                <div class="corridor-seg-warn" title="Предупредительный буфер нагрева"></div>
                <div class="corridor-seg-crit" title="Критический перегрев / самосогревание"></div>
            </div>
        </div>

        <form method="post" action="/Profiles/Update">
            <input type="hidden" name="Id" value="@f.Id" />

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;margin-bottom:0.85rem;">
                <div>
                    <label class="mc-label">Наименование культуры / объекта хранения</label>
                    <input type="text" name="CropName" class="mc-input" value="@f.CropName" required />
                </div>
                <div>
                    <label class="mc-label">Фаза вегетации / режим хранения</label>
                    <input type="text" name="GrowthStage" class="mc-input" value="@f.GrowthStage" required />
                </div>
            </div>

            <div style="margin-bottom:0.9rem;">
                <label class="mc-label">Агрономическое обоснование (научное примечание ИрГАУ)</label>
                <input type="text" name="ScientificNotes" class="mc-input" value="@f.ScientificNotes" />
            </div>

            <!-- Температура -->
            <h3 style="font-size:0.88rem;margin:0.8rem 0 0.45rem;color:var(--accent-cyan);">1. Коридор температуры воздуха / насыпи (°C)</h3>
            <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:0.55rem;margin-bottom:0.85rem;">
                <div><label class="mc-label">Крит. Мин</label><input type="number" step="0.1" name="CritTempMin" class="mc-input tabular" value="@Inv(f.CritTempMin)" /></div>
                <div><label class="mc-label">Warn Мин</label><input type="number" step="0.1" name="WarnTempMin" class="mc-input tabular" value="@Inv(f.WarnTempMin)" /></div>
                <div><label class="mc-label">Норма Мин</label><input type="number" step="0.1" name="TargetTempMin" class="mc-input tabular" value="@Inv(f.TargetTempMin)" /></div>
                <div><label class="mc-label">Норма Макс</label><input type="number" step="0.1" name="TargetTempMax" class="mc-input tabular" value="@Inv(f.TargetTempMax)" /></div>
                <div><label class="mc-label">Warn Макс</label><input type="number" step="0.1" name="WarnTempMax" class="mc-input tabular" value="@Inv(f.WarnTempMax)" /></div>
                <div><label class="mc-label">Крит. Макс</label><input type="number" step="0.1" name="CritTempMax" class="mc-input tabular" value="@Inv(f.CritTempMax)" /></div>
            </div>

            <!-- Влажность -->
            <h3 style="font-size:0.88rem;margin:0.8rem 0 0.45rem;color:var(--accent-cyan);">2. Коридор относительной влажности воздуха RH (%)</h3>
            <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:0.55rem;margin-bottom:0.85rem;">
                <div><label class="mc-label">Крит. Мин</label><input type="number" step="0.5" name="CritHumidityMin" class="mc-input tabular" value="@Inv(f.CritHumidityMin)" /></div>
                <div><label class="mc-label">Warn Мин</label><input type="number" step="0.5" name="WarnHumidityMin" class="mc-input tabular" value="@Inv(f.WarnHumidityMin)" /></div>
                <div><label class="mc-label">Норма Мин</label><input type="number" step="0.5" name="TargetHumidityMin" class="mc-input tabular" value="@Inv(f.TargetHumidityMin)" /></div>
                <div><label class="mc-label">Норма Макс</label><input type="number" step="0.5" name="TargetHumidityMax" class="mc-input tabular" value="@Inv(f.TargetHumidityMax)" /></div>
                <div><label class="mc-label">Warn Макс</label><input type="number" step="0.5" name="WarnHumidityMax" class="mc-input tabular" value="@Inv(f.WarnHumidityMax)" /></div>
                <div><label class="mc-label">Крит. Макс</label><input type="number" step="0.5" name="CritHumidityMax" class="mc-input tabular" value="@Inv(f.CritHumidityMax)" /></div>
            </div>

            <!-- VPD -->
            <h3 style="font-size:0.88rem;margin:0.8rem 0 0.45rem;color:var(--accent-cyan);">3. Дефицит упругости водяного пара VPD (кПа)</h3>
            <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:0.55rem;margin-bottom:0.85rem;">
                <div><label class="mc-label">Крит. Мин</label><input type="number" step="0.01" name="CritVpdMin" class="mc-input tabular" value="@Inv(f.CritVpdMin)" /></div>
                <div><label class="mc-label">Warn Мин</label><input type="number" step="0.01" name="WarnVpdMin" class="mc-input tabular" value="@Inv(f.WarnVpdMin)" /></div>
                <div><label class="mc-label">Норма Мин</label><input type="number" step="0.01" name="TargetVpdMin" class="mc-input tabular" value="@Inv(f.TargetVpdMin)" /></div>
                <div><label class="mc-label">Норма Макс</label><input type="number" step="0.01" name="TargetVpdMax" class="mc-input tabular" value="@Inv(f.TargetVpdMax)" /></div>
                <div><label class="mc-label">Warn Макс</label><input type="number" step="0.01" name="WarnVpdMax" class="mc-input tabular" value="@Inv(f.WarnVpdMax)" /></div>
                <div><label class="mc-label">Крит. Макс</label><input type="number" step="0.01" name="CritVpdMax" class="mc-input tabular" value="@Inv(f.CritVpdMax)" /></div>
            </div>

            <!-- CO2 + Тренды + Grace Period -->
            <h3 style="font-size:0.88rem;margin:0.8rem 0 0.45rem;color:var(--accent-cyan);">4. Газовый режим CO₂, точка росы, тренды и Grace Period</h3>
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.55rem;margin-bottom:0.75rem;">
                <div><label class="mc-label">CO₂ Норма Мин (ppm)</label><input type="number" step="10" name="TargetCo2Min" class="mc-input tabular" value="@Inv(f.TargetCo2Min)" /></div>
                <div><label class="mc-label">CO₂ Норма Макс (ppm)</label><input type="number" step="10" name="TargetCo2Max" class="mc-input tabular" value="@Inv(f.TargetCo2Max)" /></div>
                <div><label class="mc-label">CO₂ Warn Макс (ppm)</label><input type="number" step="10" name="WarnCo2Max" class="mc-input tabular" value="@Inv(f.WarnCo2Max)" /></div>
                <div><label class="mc-label">CO₂ Крит. Макс (ppm)</label><input type="number" step="10" name="CritCo2Max" class="mc-input tabular" value="@Inv(f.CritCo2Max)" /></div>
            </div>

            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.55rem;margin-bottom:0.85rem;">
                <div><label class="mc-label">Запас T−Tdp (°C)</label><input type="number" step="0.1" name="MinDewPointSpreadC" class="mc-input tabular" value="@Inv(f.MinDewPointSpreadC)" /></div>
                <div><label class="mc-label">Макс спад (°C/мин)</label><input type="number" step="0.05" name="MaxAllowedTempDropRatePerMin" class="mc-input tabular" value="@Inv(f.MaxAllowedTempDropRatePerMin)" /></div>
                <div><label class="mc-label">Макс рост (°C/мин)</label><input type="number" step="0.05" name="MaxAllowedTempRiseRatePerMin" class="mc-input tabular" value="@Inv(f.MaxAllowedTempRiseRatePerMin)" /></div>
                <div><label class="mc-label">Grace Period (сек)</label><input type="number" step="1" name="GracePeriodSeconds" class="mc-input tabular" value="@f.GracePeriodSeconds" /></div>
                <div><label class="mc-label">Запас выживания (мин)</label><input type="number" step="1" name="BaseTimeToDamageMinutes" class="mc-input tabular" value="@f.BaseTimeToDamageMinutes" /></div>
            </div>

            <div style="margin-bottom:1rem;">
                <label class="mc-label">Шаги аварийного регламента для War Room (разделитель «|»)</label>
                <textarea name="EmergencyPlaybookSteps" class="mc-textarea" rows="3">@f.EmergencyPlaybookSteps</textarea>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:0.6rem;">
                <button type="submit" class="mc-btn mc-btn-primary" @(canEdit ? "" : "disabled")>
                    💾 Сохранить профиль и записать ревизию в Temporal Table
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Секция системного аудита MS SQL Server Temporal Tables (FOR SYSTEM_TIME ALL) -->
<div class="mc-card" style="margin-top:1.25rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.8rem;flex-wrap:wrap;margin-bottom:0.8rem;">
        <div>
            <h2 style="margin:0;font-size:1.05rem;font-weight:800;">
                🕰 Журнал версий норм MS SQL Server Temporal Table (<code>FOR SYSTEM_TIME ALL</code>)
            </h2>
            <div style="font-size:0.79rem;color:var(--text-secondary);">
                Неизменяемый системный аудит: кто и когда менял пороговые значения культуры и какие нормы действовали в момент прошлых аварий
            </div>
        </div>
        <div style="display:flex;gap:0.45rem;">
            <button type="button" class="mc-btn mc-btn-sm mc-btn-primary"
                    hx-get="/Profiles/HistoryPartial?profileId=@Model.SelectedProfile.Id"
                    hx-target="#temporal-history-host"
                    hx-swap="innerHTML">
                Только текущая культура
            </button>
            <button type="button" class="mc-btn mc-btn-sm"
                    hx-get="/Profiles/HistoryPartial"
                    hx-target="#temporal-history-host"
                    hx-swap="innerHTML">
                Показать все культуры ИрГАУ
            </button>
        </div>
    </div>

    <div id="temporal-history-host">
        @await Html.PartialAsync("_TemporalHistoryTable", Model.TemporalHistory)
    </div>
</div>
