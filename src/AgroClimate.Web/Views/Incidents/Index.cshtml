@model IncidentsIndexViewModel
@{
    ViewData["Title"] = "Журнал инцидентов и War Room";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Оперативное управление угрозами микроклимата</p>
        <h1>Incident War Room</h1>
        <p class="page-description">Единый реестр активных и завершённых климатических инцидентов ИрГАУ с контролем времени реакции (MTTA), регламентами дежурной смены и выгрузкой неизменяемых актов расследования Postmortem PDF.</p>
    </div>
    <div class="header-actions">
        <a href="/Analytics" class="btn btn-outline-primary">Аналитика SLA и трендов</a>
        <a href="/" class="btn btn-primary">Стенд сценариев на карте</a>
    </div>
</header>

<section class="analysis-summary mb-4">
    <article>
        <span>Активные тревоги</span>
        <strong style="color:@(Model.ActiveCount > 0 ? "var(--agro-danger)" : "var(--agro-primary)");">@Model.ActiveCount</strong>
        <small>открытые комнаты оперативного реагирования</small>
    </article>
    <article>
        <span>Устранено в архиве</span>
        <strong>@Model.ResolvedCount</strong>
        <small>доступны подписанные Postmortem PDF-акты</small>
    </article>
    <article>
        <span>Средняя реакция (MTTA)</span>
        <strong>@Model.AvgMttaMinutes.ToString("F1") мин</strong>
        <small>от открытия тревоги до Acknowledge сменой</small>
    </article>
    <article>
        <span>Среднее устранение (MTTR)</span>
        <strong>@Model.AvgMttrMinutes.ToString("F1") мин</strong>
        <small>возврат в зелёный агрономический коридор</small>
    </article>
</section>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="mode-tabs" id="inc-filter-group">
        <button type="button" class="mode-tab-btn @(Model.StatusFilter == "all" ? "active" : "")"
                hx-get="/Incidents/ListPartial?status=all" hx-target="#incidents-table-host" hx-swap="innerHTML"
                onclick="highlightIncFilter(this)">Все запуски и инциденты</button>
        <button type="button" class="mode-tab-btn @(Model.StatusFilter == "active" ? "active" : "")"
                hx-get="/Incidents/ListPartial?status=active" hx-target="#incidents-table-host" hx-swap="innerHTML"
                onclick="highlightIncFilter(this)">Активные тревоги</button>
        <button type="button" class="mode-tab-btn @(Model.StatusFilter == "resolved" ? "active" : "")"
                hx-get="/Incidents/ListPartial?status=resolved" hx-target="#incidents-table-host" hx-swap="innerHTML"
                onclick="highlightIncFilter(this)">Архив завершённых</button>
        <button type="button" class="mode-tab-btn"
                hx-get="/Incidents/ListPartial?status=all&severity=Emergency" hx-target="#incidents-table-host" hx-swap="innerHTML"
                onclick="highlightIncFilter(this)">Emergency</button>
        <button type="button" class="mode-tab-btn"
                hx-get="/Incidents/ListPartial?status=all&severity=Critical" hx-target="#incidents-table-host" hx-swap="innerHTML"
                onclick="highlightIncFilter(this)">Critical</button>
    </div>

    <input type="search" class="form-control form-control-sm" style="width:280px;"
           placeholder="Быстрый фильтр по объекту, коду или тексту…"
           data-table-filter="incidentsRegistryTable"
           aria-label="Фильтр по журналу инцидентов" />
</div>

<div id="incidents-table-host">
    @await Html.PartialAsync("_IncidentsTable", Model)
</div>

@section Scripts {
    <script>
        function highlightIncFilter(btn) {
            document.querySelectorAll("#inc-filter-group .mode-tab-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
        }
    </script>
}
