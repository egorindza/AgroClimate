@model Incident
@{
    string sevBadge = Model.Severity >= IncidentSeverity.Critical
        ? "agro-badge agro-badge-danger"
        : "agro-badge agro-badge-warn";

    string statusBadge = Model.Status == IncidentStatus.Resolved
        ? "agro-badge"
        : Model.Status == IncidentStatus.Open
            ? "agro-badge agro-badge-danger"
            : "agro-badge agro-badge-warn";

    string statusLabel = Model.Status switch
    {
        IncidentStatus.Resolved => "Закрыт · нормализован",
        IncidentStatus.Mitigating => "Выполняются меры регламента",
        IncidentStatus.Acknowledged => "Принят в работу сменой",
        _ => "Открыт · ожидает реакции"
    };

    string StepClass(IncidentStatus target)
    {
        if (Model.Status == target) return "agro-step active";
        if ((int)Model.Status > (int)target) return "agro-step done";
        return "agro-step";
    }
}

<!-- Пошаговый индикатор жизненного цикла инцидента (в стиле Stepper из ITS AgroVision V2) -->
<div class="agro-stepper">
    <div class="@StepClass(IncidentStatus.Open)">
        <span class="agro-step-num">1</span>
        <span>Открыт (фиксация аномалии)</span>
    </div>
    <span class="agro-step-arrow">→</span>
    <div class="@StepClass(IncidentStatus.Acknowledged)">
        <span class="agro-step-num">2</span>
        <span>Принят сменой (Acknowledge)</span>
    </div>
    <span class="agro-step-arrow">→</span>
    <div class="@StepClass(IncidentStatus.Mitigating)">
        <span class="agro-step-num">3</span>
        <span>Регламент устранения</span>
    </div>
    <span class="agro-step-arrow">→</span>
    <div class="@StepClass(IncidentStatus.Resolved)">
        <span class="agro-step-num">4</span>
        <span>Закрыт и акт Postmortem PDF</span>
    </div>
</div>

<div class="panel @(Model.IsActive ? "mc-card-critical" : "preview-highlight") mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <span class="@sevBadge">@Model.Severity</span>
                <span class="@statusBadge" id="wr-status-badge">@statusLabel</span>
                <span class="agro-badge agro-badge-info">@Model.TriggerType</span>
            </div>

            <h1 class="h3 fw-bold mb-1">@Model.IncidentNumber — @Model.Title</h1>
            <div class="small text-muted">
                Объект: <strong style="color:var(--agro-text);">@Model.Zone?.Name</strong> (@Model.Zone?.LocationCampus) ·
                Открыт: <strong>@Model.OpenedAtUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss") (ИРК)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.AcknowledgedBy))
                {
                    <span> · Ответственный: <strong>@Model.AcknowledgedBy</strong></span>
                }
            </div>
            <div class="mt-2" style="font-size:.9rem;">
                <strong>Сводка мониторинга:</strong> <span id="wr-summary-text">@Model.AlertSummary</span>
            </div>
        </div>

        <div class="d-flex flex-column align-items-end gap-2">
            @if (Model.IsActive)
            {
                <div class="tabular text-end p-2 px-3 rounded" style="background:var(--agro-danger-bg);border:1px solid var(--agro-danger);">
                    <div style="font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--agro-danger);">
                        Запас времени до риска порчи культуры
                    </div>
                    <div id="wr-survival-timer"
                         data-minutes="@Model.EstimatedMinutesToDamage"
                         style="font-size:1.5rem;font-weight:800;color:var(--agro-danger);">
                        @Model.EstimatedMinutesToDamage:00 мин
                    </div>
                </div>
            }
            else
            {
                <div class="tabular text-end p-2 px-3 rounded" style="background:var(--agro-badge-bg);border:1px solid var(--agro-primary);">
                    <div style="font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--agro-primary);">
                        Инцидент закрыт
                    </div>
                    <div style="font-size:1.1rem;font-weight:800;color:var(--agro-primary);">
                        MTTR: @(Model.MttrMinutes?.ToString("F1") ?? "—") мин
                    </div>
                </div>
            }

            <div class="d-flex gap-2 flex-wrap">
                @if (Model.Status == IncidentStatus.Open)
                {
                    <form hx-post="/Incidents/Acknowledge/@Model.Id"
                          hx-target="#wr-header-host"
                          hx-swap="innerHTML"
                          method="post"
                          action="/Incidents/Acknowledge/@Model.Id"
                          style="margin:0;">
                        <button type="submit" class="btn btn-warning btn-sm fw-bold">✋ Взять в работу (Acknowledge)</button>
                    </form>
                }
                <a href="/Incidents/PostmortemPdf/@Model.Id" class="btn btn-primary btn-sm">
                    📄 Выгрузить акт Postmortem PDF
                </a>
            </div>
        </div>
    </div>
</div>
