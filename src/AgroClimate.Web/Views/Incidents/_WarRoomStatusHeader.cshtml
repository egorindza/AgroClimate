@model Incident
@{
    string sevBadge = Model.Severity >= IncidentSeverity.Critical
        ? "mc-badge mc-badge-critical"
        : "mc-badge mc-badge-warning";

    string statusBadge = Model.Status == IncidentStatus.Resolved
        ? "mc-badge mc-badge-optimal"
        : Model.Status == IncidentStatus.Open
            ? "mc-badge mc-badge-critical"
            : "mc-badge mc-badge-warning";

    string statusLabel = Model.Status switch
    {
        IncidentStatus.Resolved => "ЗАКРЫТ • УГРОЗА УСТРАНЕНА",
        IncidentStatus.Mitigating => "ВЫПОЛНЯЮТСЯ МЕРЫ РЕГЛАМЕНТА",
        IncidentStatus.Acknowledged => "ПРИНЯТ В РАБОТУ ДЕЖУРНОЙ СМЕНОЙ",
        _ => "ОТКРЫТ • ТРЕБУЕТСЯ РЕАКЦИЯ СМЕНЫ"
    };
}

<div class="mc-card @(Model.IsActive ? "mc-card-critical" : "")" style="margin-bottom:1.1rem;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
        <div>
            <div style="display:flex;align-items:center;gap:0.55rem;flex-wrap:wrap;">
                <a href="/Incidents" class="mc-btn mc-btn-sm">← К журналу</a>
                <span class="@sevBadge">@Model.Severity</span>
                <span class="@statusBadge" id="wr-status-badge">@statusLabel</span>
                <span class="mc-badge mc-badge-info">@Model.TriggerType</span>
            </div>

            <h1 style="margin:0.55rem 0 0.25rem;font-size:1.3rem;font-weight:800;">
                @Model.IncidentNumber — @Model.Title
            </h1>
            <div style="font-size:0.84rem;color:var(--text-secondary);">
                Объект: <strong style="color:var(--text-primary);">@Model.Zone?.Name</strong> (@Model.Zone?.LocationCampus) •
                Открыт: <strong>@Model.OpenedAtUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss") (ИРК)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.AcknowledgedBy))
                {
                    <span> • В работе у: <strong>@Model.AcknowledgedBy</strong></span>
                }
            </div>
            <div style="margin-top:0.45rem;font-size:0.86rem;color:var(--text-primary);">
                <strong>Диагностика ядра:</strong> <span id="wr-summary-text">@Model.AlertSummary</span>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.55rem;">
            @if (Model.IsActive)
            {
                <div class="tabular" style="background:var(--accent-red-soft);border:1px solid var(--accent-red);border-radius:10px;padding:0.5rem 0.9rem;text-align:right;">
                    <div style="font-size:0.69rem;text-transform:uppercase;font-weight:700;color:var(--accent-red);">
                        Запас времени до риска порчи продукции
                    </div>
                    <div id="wr-survival-timer"
                         data-minutes="@Model.EstimatedMinutesToDamage"
                         style="font-size:1.55rem;font-weight:900;color:var(--accent-red);">
                        @Model.EstimatedMinutesToDamage:00 мин
                    </div>
                </div>
            }
            else
            {
                <div class="tabular" style="background:var(--accent-emerald-soft);border:1px solid var(--accent-emerald);border-radius:10px;padding:0.5rem 0.9rem;text-align:right;">
                    <div style="font-size:0.7rem;text-transform:uppercase;font-weight:700;color:var(--accent-emerald);">
                        Инцидент успешно закрыт
                    </div>
                    <div style="font-size:1.05rem;font-weight:800;color:var(--accent-emerald);">
                        MTTR: @(Model.MttrMinutes?.ToString("F1") ?? "—") мин
                    </div>
                </div>
            }

            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                @if (Model.Status == IncidentStatus.Open)
                {
                    <form hx-post="/Incidents/Acknowledge/@Model.Id"
                          hx-target="#wr-header-host"
                          hx-swap="innerHTML"
                          method="post"
                          action="/Incidents/Acknowledge/@Model.Id"
                          style="margin:0;">
                        <button type="submit" class="mc-btn mc-btn-amber">✋ Взять в работу (Acknowledge)</button>
                    </form>
                }
                <a href="/Incidents/PostmortemPdf/@Model.Id" class="mc-btn mc-btn-primary">
                    📄 Выгрузить акт Postmortem PDF
                </a>
            </div>
        </div>
    </div>
</div>
