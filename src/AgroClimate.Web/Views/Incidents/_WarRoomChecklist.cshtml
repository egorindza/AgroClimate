@model Incident

<div class="panel mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <p class="eyebrow mb-0">Экстренный регламент реагирования</p>
            <h2 class="h5 fw-bold mb-0">Чек-лист дежурной смены ИрГАУ</h2>
        </div>
        <span class="agro-badge tabular" id="wr-checklist-pct">
            Выполнено: @Model.ChecklistCompletionPercent%
        </span>
    </div>

    <div style="height:8px;background:var(--agro-surface-alt);border-radius:999px;overflow:hidden;margin:0.65rem 0 0.9rem;border:1px solid var(--agro-border);">
        <div id="wr-checklist-bar" style="height:100%;width:@Model.ChecklistCompletionPercent%;background:var(--agro-primary);transition:width 0.3s ease;"></div>
    </div>

    @foreach (var item in Model.ChecklistItems.OrderBy(x => x.StepOrder))
    {
        if (Model.IsActive)
        {
            <form hx-post="/Incidents/ToggleChecklist"
                  hx-target="#wr-checklist-host"
                  hx-swap="innerHTML"
                  method="post"
                  action="/Incidents/ToggleChecklist"
                  style="margin:0;">
                <input type="hidden" name="incidentId" value="@Model.Id" />
                <input type="hidden" name="itemId" value="@item.Id" />
                <button type="submit" class="checklist-row @(item.IsCompleted ? "done" : "")" style="width:100%;text-align:left;">
                    <span style="font-size:1.05rem;line-height:1.2;">@(item.IsCompleted ? "✅" : "⬜")</span>
                    <div style="flex:1;">
                        <div style="font-weight:650;font-size:.88rem;@(item.IsCompleted ? "text-decoration:line-through;opacity:0.85;" : "")">
                            Шаг @item.StepOrder. @item.Instruction
                        </div>
                        @if (item.IsCompleted && item.CompletedAtUtc.HasValue)
                        {
                            <div style="font-size:.76rem;color:var(--agro-primary);margin-top:.15rem;">
                                Выполнено: @item.CompletedBy · @item.CompletedAtUtc.Value.AddHours(8).ToString("HH:mm:ss") (ИРК)
                            </div>
                        }
                    </div>
                </button>
            </form>
        }
        else
        {
            <div class="checklist-row @(item.IsCompleted ? "done" : "")" style="cursor:default;">
                <span style="font-size:1.05rem;line-height:1.2;">@(item.IsCompleted ? "✅" : "⬜")</span>
                <div style="flex:1;">
                    <div style="font-weight:650;font-size:.88rem;">Шаг @item.StepOrder. @item.Instruction</div>
                    @if (item.IsCompleted && item.CompletedAtUtc.HasValue)
                    {
                        <div style="font-size:.76rem;color:var(--agro-primary);margin-top:.15rem;">
                            Выполнено: @item.CompletedBy · @item.CompletedAtUtc.Value.AddHours(8).ToString("HH:mm:ss") (ИРК)
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
