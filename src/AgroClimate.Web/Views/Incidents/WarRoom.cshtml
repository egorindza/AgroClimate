@model WarRoomViewModel
@{
    var inc = Model.Incident;
    var zone = inc.Zone;
    var snap = Model.HistoricalProfileSnapshot;
    ViewData["Title"] = inc.IncidentNumber;
}

<div id="warroom-root" data-incident-id="@inc.Id" data-zone-id="@inc.ZoneId">
    @if (TempData["WarRoomError"] is string err)
    {
        <div class="alert alert-danger" role="alert">@err</div>
    }
    @if (TempData["WarRoomSuccess"] is string ok)
    {
        <div class="alert alert-success" role="status">@ok</div>
    }

    <div id="wr-header-host">
        @await Html.PartialAsync("_WarRoomStatusHeader", inc)
    </div>

    <div class="warroom-grid">
        <!-- Левая колонка -->
        <div>
            @if (zone is not null)
            {
                <div class="panel mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <p class="eyebrow mb-0">Живой поток объекта</p>
                            <h2 class="h5 fw-bold mb-0">@zone.Name (<code>@zone.ControllerNodeId</code>)</h2>
                        </div>
                        <span id="wr-sensor-state" class="agro-badge @(zone.IsSensorOnline ? "" : "agro-badge-danger")">
                            @(zone.IsSensorOnline ? "Датчик на связи" : "Потеря сигнала")
                        </span>
                    </div>

                    <div class="metric-matrix tabular">
                        <div class="metric-cell">
                            <div class="metric-cell-label">Текущая T°</div>
                            <div class="metric-cell-val" id="wr-live-temp">@zone.CurrentTempC.ToString("F1")</div>
                            <div class="metric-cell-unit">°C (старт @inc.InitialTempC.ToString("F1")°C)</div>
                        </div>
                        <div class="metric-cell">
                            <div class="metric-cell-label">Влажность</div>
                            <div class="metric-cell-val" id="wr-live-hum">@zone.CurrentHumidityPercent.ToString("F1")</div>
                            <div class="metric-cell-unit">% RH</div>
                        </div>
                        <div class="metric-cell">
                            <div class="metric-cell-label">CO₂</div>
                            <div class="metric-cell-val" id="wr-live-co2">@zone.CurrentCo2Ppm.ToString("F0")</div>
                            <div class="metric-cell-unit">ppm</div>
                        </div>
                        <div class="metric-cell">
                            <div class="metric-cell-label">Точка росы</div>
                            <div class="metric-cell-val" id="wr-live-dp">@zone.CurrentDewPointC.ToString("F1")</div>
                            <div class="metric-cell-unit">°C T<sub>dp</sub></div>
                        </div>
                        <div class="metric-cell">
                            <div class="metric-cell-label">VPD</div>
                            <div class="metric-cell-val" id="wr-live-vpd">@zone.CurrentVpdKpa.ToString("F2")</div>
                            <div class="metric-cell-unit">кПа</div>
                        </div>
                    </div>

                    <div style="height:195px;margin-top:0.5rem;">
                        <canvas id="wr-live-chart"></canvas>
                    </div>
                </div>
            }

            <div id="wr-checklist-host">
                @await Html.PartialAsync("_WarRoomChecklist", inc)
            </div>

            <!-- Снимок Temporal Table на момент открытия аварии -->
            <div class="panel mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div>
                        <p class="eyebrow mb-0">Неизменяемый аудит норм MS SQL Server</p>
                        <h2 class="h5 fw-bold mb-0">Срез Temporal Table (<code>FOR SYSTEM_TIME AS OF</code>)</h2>
                    </div>
                    <span class="agro-badge">SYSTEM_VERSIONING = ON</span>
                </div>
                @if (snap is not null)
                {
                    <p class="small text-muted mb-2">
                        На момент фиксации инцидента (<strong>@inc.OpenedAtUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss") ИРК</strong>) для культуры
                        <strong style="color:var(--agro-text);">@snap.CropName (@snap.GrowthStage)</strong> действовала ревизия:
                    </p>
                    <dl class="row small tabular mb-1">
                        <dt class="col-sm-4 text-muted">Целевой коридор T°:</dt>
                        <dd class="col-sm-8 fw-bold">@snap.TargetTempMin.ToString("F1")..@snap.TargetTempMax.ToString("F1") °C (крит. @snap.CritTempMin.ToString("F1")..@snap.CritTempMax.ToString("F1") °C)</dd>

                        <dt class="col-sm-4 text-muted">Влажность и VPD:</dt>
                        <dd class="col-sm-8 fw-bold">RH @snap.TargetHumidityMin.ToString("F0")..@snap.TargetHumidityMax.ToString("F0") % · VPD @snap.TargetVpdMin.ToString("F2")..@snap.TargetVpdMax.ToString("F2") кПа</dd>

                        <dt class="col-sm-4 text-muted">Крит. CO₂ и Grace Period:</dt>
                        <dd class="col-sm-8 fw-bold">@snap.CritCo2Max.ToString("F0") ppm · Grace Period: @snap.GracePeriodSeconds с</dd>

                        <dt class="col-sm-4 text-muted">Утвердил ревизию:</dt>
                        <dd class="col-sm-8 mb-0">@snap.LastModifiedBy (с @snap.ValidFromUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm"))</dd>
                    </dl>
                }
            </div>

            <!-- Закрытие инцидента / Postmortem -->
            @if (inc.IsActive)
            {
                <div class="panel">
                    <p class="eyebrow mb-0">Завершение реагирования</p>
                    <h2 class="h5 fw-bold mb-2">Закрытие инцидента и формирование паспорта Postmortem</h2>
                    @if (User.CanResolveIncidents())
                    {
                        <form method="post" action="/Incidents/Resolve">
                            <input type="hidden" name="IncidentId" value="@inc.Id" />
                            <div class="mb-2">
                                <label class="form-label">Установленная первопричина аварии (Root Cause Analysis)</label>
                                <textarea name="RootCauseAnalysis" class="form-control" rows="2" required
                                          placeholder="Напр.: Остановка циркуляционного насоса контура №1 при морозе -36°C / зависание трансивера RS-485…"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Выполненные инженерно-агрономические меры</label>
                                <textarea name="ResolutionSummary" class="form-control" rows="2" required
                                          placeholder="Напр.: Запущен резервный теплогенератор ТГ-2, восстановлена циркуляция, температура стабилизирована…"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                Подтвердить нормализацию и закрыть инцидент
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Текущая роль (<strong>@User.GetRoleTitle()</strong>) может вести журнал смены и принимать тревогу.
                            Официальное закрытие инцидента доступно ролям <strong>Агроном</strong> или <strong>КИПиА</strong> (переключение в 1 клик в левой панели).
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="panel preview-highlight">
                    <p class="eyebrow mb-0">Итоги расследования</p>
                    <h2 class="h5 fw-bold mb-2">Заключение комиссии ИрГАУ (Postmortem)</h2>
                    <p class="mb-1"><strong>Закрыл:</strong> @inc.ResolvedBy (@inc.ResolvedAtUtc?.AddHours(8).ToString("dd.MM.yyyy HH:mm:ss") ИРК)</p>
                    <p class="mb-1"><strong>Первопричина (Root Cause):</strong> @inc.RootCauseAnalysis</p>
                    <p class="mb-3"><strong>Выполненные меры:</strong> @inc.ResolutionSummary</p>
                    <a href="/Incidents/PostmortemPdf/@inc.Id" class="btn btn-primary">
                        📄 Скачать подписанный акт Postmortem (PDF)
                    </a>
                </div>
            }
        </div>

        <!-- Правая колонка: Живая лента смены -->
        <div>
            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <p class="eyebrow mb-0">Синхронизация SignalR</p>
                        <h2 class="h5 fw-bold mb-0">Живая лента смены (Timeline)</h2>
                    </div>
                    <span class="agro-badge">Real-Time</span>
                </div>

                <form id="wr-comment-form"
                      hx-post="/Incidents/Comment"
                      hx-swap="none"
                      hx-on::after-request="if(event.detail.successful) this.reset();"
                      method="post"
                      action="/Incidents/Comment"
                      class="mb-3 mt-2">
                    <input type="hidden" name="IncidentId" value="@inc.Id" />
                    <div class="d-flex gap-2">
                        <input type="text"
                               name="Comment"
                               class="form-control"
                               required
                               maxlength="600"
                               placeholder="Запись в журнал смены (напр.: Проверил коллектор, запускаю ТГ-2)…" />
                        <button type="submit" class="btn btn-primary text-nowrap">Отправить</button>
                    </div>
                </form>

                <div class="timeline-list" id="wr-timeline-list">
                    @foreach (var ev in inc.TimelineEvents.OrderByDescending(e => e.OccurredAtUtc))
                    {
                        <div class="timeline-item ev-@ev.EventType">
                            <div class="d-flex justify-content-between gap-2 small text-muted mb-1">
                                <span><strong style="color:var(--agro-text);">@ev.AuthorName</strong> · @ev.AuthorRole</span>
                                <span class="tabular">@ev.OccurredAtUtc.AddHours(8).ToString("dd.MM HH:mm:ss")</span>
                            </div>
                            <div style="font-size:.88rem;">@ev.Message</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const root = document.getElementById("warroom-root");
            if (!root) return;
            const incidentId = parseInt(root.dataset.incidentId, 10);
            const zoneId = parseInt(root.dataset.zoneId, 10);

            let remainingSeconds = 0;
            const timerEl = document.getElementById("wr-survival-timer");
            if (timerEl && timerEl.dataset.minutes) {
                remainingSeconds = parseInt(timerEl.dataset.minutes, 10) * 60;
                setInterval(() => {
                    const el = document.getElementById("wr-survival-timer");
                    if (!el) return;
                    if (remainingSeconds > 0) remainingSeconds--;
                    const m = Math.floor(remainingSeconds / 60);
                    const s = remainingSeconds % 60;
                    el.textContent = `${m}:${s.toString().padStart(2, "0")} мин`;
                }, 1000);
            }

            let wrChart = null;
            const ctx = document.getElementById("wr-live-chart");
            if (ctx && typeof Chart !== "undefined") {
                fetch(`/Analytics/TimeSeriesData?zoneId=${zoneId}&hours=1`)
                    .then(r => r.json())
                    .then(data => {
                        wrChart = new Chart(ctx, {
                            type: "line",
                            data: {
                                labels: data.labels.slice(-30),
                                datasets: [
                                    {
                                        label: "Температура (°C)",
                                        data: data.temps.slice(-30),
                                        borderColor: "#1c7c49",
                                        backgroundColor: "rgba(28,124,73,0.12)",
                                        fill: true,
                                        tension: 0.3,
                                        borderWidth: 2.4
                                    },
                                    {
                                        label: "Точка росы Tdp (°C)",
                                        data: data.dewPoints.slice(-30),
                                        borderColor: "#2563eb",
                                        borderDash: [5, 4],
                                        tension: 0.3,
                                        borderWidth: 1.8
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                animation: false,
                                plugins: { legend: { labels: { boxWidth: 14 } } },
                                scales: {
                                    x: { ticks: { maxTicksLimit: 8 } }
                                }
                            }
                        });
                    });
            }

            window.addEventListener("agro:telemetry", function (e) {
                const t = e.detail;
                if (!t || t.zoneId !== zoneId) return;

                const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
                setTxt("wr-live-temp", t.temperatureC.toFixed(1));
                setTxt("wr-live-hum", t.humidityPercent.toFixed(1));
                setTxt("wr-live-co2", Math.round(t.co2Ppm).toString());
                setTxt("wr-live-dp", t.dewPointC.toFixed(1));
                setTxt("wr-live-vpd", t.vpdKpa.toFixed(2));

                const st = document.getElementById("wr-sensor-state");
                if (st) {
                    st.className = t.isSensorOnline ? "agro-badge" : "agro-badge agro-badge-danger";
                    st.textContent = t.isSensorOnline ? "Датчик на связи" : "Потеря сигнала";
                }

                if (wrChart && t.isSensorOnline) {
                    const nowLabel = new Date(t.recordedAtUtc).toLocaleTimeString("ru-RU");
                    wrChart.data.labels.push(nowLabel);
                    wrChart.data.datasets[0].data.push(t.temperatureC);
                    wrChart.data.datasets[1].data.push(t.dewPointC);
                    if (wrChart.data.labels.length > 35) {
                        wrChart.data.labels.shift();
                        wrChart.data.datasets[0].data.shift();
                        wrChart.data.datasets[1].data.shift();
                    }
                    wrChart.update("none");
                }
            });

            window.addEventListener("agro:incident", function (e) {
                const ev = e.detail;
                if (!ev || ev.incidentId !== incidentId) return;

                if (typeof ev.estimatedMinutesToDamage === "number") {
                    remainingSeconds = ev.estimatedMinutesToDamage * 60;
                }

                const pctEl = document.getElementById("wr-checklist-pct");
                if (pctEl) pctEl.textContent = `Выполнено: ${ev.checklistCompletionPercent}%`;
                const barEl = document.getElementById("wr-checklist-bar");
                if (barEl) barEl.style.width = `${ev.checklistCompletionPercent}%`;

                const list = document.getElementById("wr-timeline-list");
                if (list) {
                    const item = document.createElement("div");
                    item.className = `timeline-item ev-${ev.eventType} flash-update`;

                    const top = document.createElement("div");
                    top.className = "d-flex justify-content-between gap-2 small text-muted mb-1";

                    const authorSpan = document.createElement("span");
                    const strong = document.createElement("strong");
                    strong.style.color = "var(--agro-text)";
                    strong.textContent = ev.authorName;
                    authorSpan.appendChild(strong);
                    authorSpan.appendChild(document.createTextNode(" · " + ev.authorRole));

                    const timeSpan = document.createElement("span");
                    timeSpan.className = "tabular";
                    timeSpan.textContent = new Date(ev.occurredAtUtc).toLocaleTimeString("ru-RU");

                    top.appendChild(authorSpan);
                    top.appendChild(timeSpan);

                    const body = document.createElement("div");
                    body.style.fontSize = "0.88rem";
                    body.textContent = ev.message;

                    item.appendChild(top);
                    item.appendChild(body);
                    list.prepend(item);
                }
            });
        })();
    </script>
}
