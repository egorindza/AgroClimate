@model IncidentsIndexViewModel

@if (Model.Incidents.Count == 0)
{
    <div class="panel empty-state">
        <strong>По выбранным фильтрам инцидентов не найдено</strong>
        <span>Запустите один из аварийных сценариев в C# IoT-симуляторе на главной панели для живой демонстрации War Room.</span>
        <div class="mt-3">
            <a href="/" class="btn btn-primary">Открыть стенд сценариев</a>
        </div>
    </div>
}
else
{
    <div class="panel p-0 overflow-hidden">
        <div class="table-responsive" style="max-height:560px;">
            <table id="incidentsRegistryTable" class="table table-sticky tabular">
                <thead>
                    <tr>
                        <th>Код</th>
                        <th>Объект и культура</th>
                        <th>Критичность / Триггер</th>
                        <th>Сводка автоматики</th>
                        <th>Статус / Регламент</th>
                        <th>Открыт (ИРК)</th>
                        <th>MTTA / MTTR</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inc in Model.Incidents)
                    {
                        string sevBadge = inc.Severity >= IncidentSeverity.Critical
                            ? "agro-badge agro-badge-danger"
                            : "agro-badge agro-badge-warn";

                        string stBadge = inc.Status == IncidentStatus.Resolved
                            ? "agro-badge"
                            : inc.Status == IncidentStatus.Open
                                ? "agro-badge agro-badge-danger"
                                : "agro-badge agro-badge-warn";

                        string stLabel = inc.Status switch
                        {
                            IncidentStatus.Resolved => "Закрыт",
                            IncidentStatus.Mitigating => "Устранение",
                            IncidentStatus.Acknowledged => "В работе",
                            _ => "Ожидает смены"
                        };

                        <tr>
                            <td><code>@inc.IncidentNumber</code></td>
                            <td>
                                <strong>@inc.Zone?.Name</strong><br />
                                <small class="text-muted">@inc.Zone?.AgroProfile?.CropName</small>
                            </td>
                            <td>
                                <span class="@sevBadge">@inc.Severity</span>
                                <div class="small text-muted mt-1">@inc.TriggerType</div>
                            </td>
                            <td style="max-width:340px;">
                                <div class="fw-semibold">@inc.Title</div>
                                <div class="small text-muted">@inc.AlertSummary</div>
                            </td>
                            <td>
                                <span class="@stBadge">@stLabel</span>
                                <div class="small text-muted mt-1">Чек-лист: <strong>@inc.ChecklistCompletionPercent%</strong></div>
                            </td>
                            <td class="text-nowrap small">@inc.OpenedAtUtc.AddHours(8).ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="small text-nowrap">
                                <div>MTTA: <strong>@(inc.MttaMinutes.HasValue ? $"{inc.MttaMinutes:F1} мин" : "—")</strong></div>
                                <div>MTTR: <strong>@(inc.MttrMinutes.HasValue ? $"{inc.MttrMinutes:F1} мин" : "в работе")</strong></div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="/Incidents/WarRoom/@inc.Id" class="btn @(inc.IsActive ? "btn-danger" : "btn-outline-primary") btn-sm">
                                    @(inc.IsActive ? "War Room" : "Разбор")
                                </a>
                                <a href="/Incidents/PostmortemPdf/@inc.Id" class="btn btn-outline-secondary btn-sm ms-1" title="Скачать официальный PDF-акт расследования">
                                    PDF
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
