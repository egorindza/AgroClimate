@model IReadOnlyList<WindowTrendAnomalyDto>

<div class="table-responsive">
    <table class="table table-sticky tabular">
        <thead>
            <tr>
                <th>Объект ИрГАУ</th>
                <th>Текущая T°</th>
                <th>LAG (пред.) / Δ</th>
                <th>FIRST_VALUE (окно)</th>
                <th>AVG (скольз.)</th>
                <th>STDEV (СКО σ)</th>
                <th>Скорость тренда</th>
                <th>RH% / CO₂</th>
                <th>Вердикт раннего обнаружения</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                string velColor = r.IsEarlyAnomaly ? "var(--agro-danger)" : "var(--agro-primary)";
                <tr>
                    <td><strong>@r.ZoneName</strong></td>
                    <td class="fw-bold">@r.LatestTempC.ToString("F2") °C</td>
                    <td>
                        @r.PrevTempC.ToString("F2") °C
                        <span class="text-muted">(@(r.StepDeltaC >= 0 ? "+" : "")@r.StepDeltaC.ToString("F2"))</span>
                    </td>
                    <td>@r.WindowFirstTempC.ToString("F2") °C</td>
                    <td>@r.MovingAvgTempC.ToString("F2") °C</td>
                    <td>±@r.MovingStdDevTempC.ToString("F3") °C</td>
                    <td class="fw-bold" style="color:@velColor;">
                        @(r.WindowVelocityPerMin >= 0 ? "+" : "")@r.WindowVelocityPerMin.ToString("F2") °C/мин
                    </td>
                    <td>@r.LatestHumidityPercent.ToString("F1")% / @r.LatestCo2Ppm.ToString("F0") ppm</td>
                    <td>
                        @if (r.IsEarlyAnomaly)
                        {
                            <span class="agro-badge agro-badge-danger">@r.TrendVerdict</span>
                        }
                        else
                        {
                            <span class="agro-badge">@r.TrendVerdict</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
