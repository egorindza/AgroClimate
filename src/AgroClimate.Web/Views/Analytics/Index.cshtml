@model AnalyticsViewModel
@{
    ViewData["Title"] = "Аналитика SLA и трендов";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Временные ряды телеметрии и предиктивная диагностика</p>
        <h1>Аналитика стабильности микроклимата и SLA</h1>
        <p class="page-description">Мгновенная обработка временных рядов через индекс <code>NONCLUSTERED COLUMNSTORE INDEX</code> и раннее выявление опасных трендов оконными функциями T-SQL (<code>LAG</code>, <code>FIRST_VALUE</code>, <code>AVG</code>, <code>STDEV</code>).</p>
    </div>
    <div class="header-actions">
        <span class="agro-badge @(Model.HasColumnstoreIndex ? "" : "agro-badge-danger")">
            Columnstore: @(Model.HasColumnstoreIndex ? "Активен" : "Откл.")
        </span>
        <span class="agro-badge @(Model.HasTemporalTable ? "" : "agro-badge-danger")">
            Temporal: @(Model.HasTemporalTable ? "Активен" : "Откл.")
        </span>
        <span class="agro-badge agro-badge-info tabular">
            Dapper: @Model.LastAnalyticalQueryMs.ToString("F2") мс (@Model.TotalColumnstoreRows.ToString("N0") строк)
        </span>
    </div>
</header>

<!-- Интерактивный эксплорер временных рядов Chart.js -->
<section class="panel mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <label class="form-label mb-0">Объект ИрГАУ:</label>
            <select id="an-zone-select" class="form-select" style="width:auto;min-width:300px;" onchange="reloadAnalyticsCharts()">
                @foreach (var z in Model.Zones)
                {
                    if (z.Id == Model.SelectedZone.Id)
                    {
                        <option value="@z.Id" selected>@z.Name (@z.AgroProfile?.CropName)</option>
                    }
                    else
                    {
                        <option value="@z.Id">@z.Name (@z.AgroProfile?.CropName)</option>
                    }
                }
            </select>
        </div>

        <div class="mode-tabs" id="an-hours-group">
            <button type="button" class="mode-tab-btn @(Model.SelectedHours == 1 ? "active" : "")" onclick="setHoursWindow(1, this)">1 час (Live)</button>
            <button type="button" class="mode-tab-btn @(Model.SelectedHours == 6 ? "active" : "")" onclick="setHoursWindow(6, this)">6 часов</button>
            <button type="button" class="mode-tab-btn @(Model.SelectedHours == 24 ? "active" : "")" onclick="setHoursWindow(24, this)">24 часа</button>
            <button type="button" class="mode-tab-btn @(Model.SelectedHours == 48 ? "active" : "")" onclick="setHoursWindow(48, this)">48 часов</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="p-3 rounded" style="background:var(--agro-surface-alt);border:1px solid var(--agro-border);">
                <div class="fw-bold small mb-2">Температура воздуха, целевой коридор и точка росы T<sub>dp</sub> (°C)</div>
                <div style="height:265px;">
                    <canvas id="an-temp-chart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-3 rounded" style="background:var(--agro-surface-alt);border:1px solid var(--agro-border);">
                <div class="fw-bold small mb-2">Относительная влажность RH (%), дефицит пара VPD (кПа) и CO₂ (×10 ppm)</div>
                <div style="height:265px;">
                    <canvas id="an-vpd-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Радар оконных функций T-SQL -->
<section class="panel mb-4">
    <div class="section-heading mb-3">
        <div>
            <p class="eyebrow">Оконные функции T-SQL в Dapper</p>
            <h2>Радар раннего обнаружения опасных трендов</h2>
            <p class="mt-1">Скользящее окно <code>OVER (PARTITION BY ZoneId ORDER BY RecordedAtUtc ROWS BETWEEN 19 PRECEDING AND CURRENT ROW)</code> выявляет стремительное охлаждение до пересечения критического нуля</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm"
                hx-get="/Analytics/WindowRadarPartial"
                hx-target="#window-radar-host"
                hx-swap="innerHTML">
            Пересчитать окно T-SQL
        </button>
    </div>

    <div id="window-radar-host">
        @await Html.PartialAsync("_WindowRadarTable", Model.WindowRadar)
    </div>
</section>

<!-- Рейтинг соблюдения климатического SLA -->
<section class="panel">
    <div class="section-heading mb-3">
        <div>
            <p class="eyebrow">Реальные операционные выборки (HTAP)</p>
            <h2>Соблюдение климатического SLA за 48 часов (<code>NONCLUSTERED COLUMNSTORE INDEX</code>)</h2>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sticky tabular">
            <thead>
                <tr>
                    <th>Климатическая зона</th>
                    <th>Культура</th>
                    <th>Выборок (48ч)</th>
                    <th>SLA (% в зелёной зоне)</th>
                    <th>Средняя T° (±σ)</th>
                    <th>Мин / Макс T°</th>
                    <th>Средн. RH%</th>
                    <th>Средн. VPD</th>
                    <th>Средн. CO₂</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.SlaSummaries)
                {
                    string slaBadge = s.SlaCompliancePercent >= 96.0
                        ? "agro-badge"
                        : s.SlaCompliancePercent >= 88.0
                            ? "agro-badge agro-badge-warn"
                            : "agro-badge agro-badge-danger";

                    <tr>
                        <td><strong>@s.ZoneName</strong></td>
                        <td class="text-muted">@s.CropName</td>
                        <td>@s.TotalSamples.ToString("N0")</td>
                        <td><span class="@slaBadge">@s.SlaCompliancePercent.ToString("F2") %</span></td>
                        <td>@s.AvgTempC.ToString("F2") °C <span class="text-muted">(±@s.TempStdDev.ToString("F2"))</span></td>
                        <td>@s.MinTempC.ToString("F1") .. @s.MaxTempC.ToString("F1") °C</td>
                        <td>@s.AvgHumidityPercent.ToString("F1") %</td>
                        <td>@s.AvgVpdKpa.ToString("F2") кПа</td>
                        <td>@s.AvgCo2Ppm.ToString("F0") ppm</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        let currentHours = @Model.SelectedHours;
        let tempChart = null;
        let vpdChart = null;

        function setHoursWindow(h, btn) {
            currentHours = h;
            document.querySelectorAll("#an-hours-group .mode-tab-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            reloadAnalyticsCharts();
        }

        function reloadAnalyticsCharts() {
            const zoneId = parseInt(document.getElementById("an-zone-select").value, 10);
            fetch(`/Analytics/TimeSeriesData?zoneId=${zoneId}&hours=${currentHours}`)
                .then(r => r.json())
                .then(d => renderCharts(d));
        }

        function renderCharts(d) {
            const tCtx = document.getElementById("an-temp-chart");
            const vCtx = document.getElementById("an-vpd-chart");
            if (!tCtx || !vCtx || typeof Chart === "undefined") return;

            if (tempChart) tempChart.destroy();
            if (vpdChart) vpdChart.destroy();

            const minLine = d.labels.map(() => d.targetTempMin);
            const maxLine = d.labels.map(() => d.targetTempMax);

            tempChart = new Chart(tCtx, {
                type: "line",
                data: {
                    labels: d.labels,
                    datasets: [
                        {
                            label: "Температура (°C)",
                            data: d.temps,
                            borderColor: "#1c7c49",
                            backgroundColor: "rgba(28,124,73,0.12)",
                            fill: false,
                            tension: 0.25,
                            borderWidth: 2.5,
                            pointRadius: 0
                        },
                        {
                            label: "Точка росы Tdp (°C)",
                            data: d.dewPoints,
                            borderColor: "#2563eb",
                            borderDash: [5, 4],
                            tension: 0.25,
                            borderWidth: 1.8,
                            pointRadius: 0
                        },
                        {
                            label: "Норма макс (°C)",
                            data: maxLine,
                            borderColor: "#d97706",
                            borderDash: [3, 3],
                            borderWidth: 1.3,
                            pointRadius: 0
                        },
                        {
                            label: "Норма мин (°C)",
                            data: minLine,
                            borderColor: "#d97706",
                            borderDash: [3, 3],
                            borderWidth: 1.3,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    interaction: { mode: "index", intersect: false },
                    plugins: { legend: { labels: { boxWidth: 12 } } },
                    scales: {
                        x: { ticks: { maxTicksLimit: 9 } }
                    }
                }
            });

            vpdChart = new Chart(vCtx, {
                type: "line",
                data: {
                    labels: d.labels,
                    datasets: [
                        {
                            label: "Влажность RH (%)",
                            data: d.humidities,
                            borderColor: "#2563eb",
                            yAxisID: "y",
                            tension: 0.25,
                            borderWidth: 2,
                            pointRadius: 0
                        },
                        {
                            label: "VPD (кПа)",
                            data: d.vpds,
                            borderColor: "#d97706",
                            yAxisID: "y1",
                            tension: 0.25,
                            borderWidth: 2.2,
                            pointRadius: 0
                        },
                        {
                            label: "CO₂ (×10 ppm)",
                            data: d.co2s.map(c => +(c / 10.0).toFixed(1)),
                            borderColor: "#1c7c49",
                            yAxisID: "y",
                            borderDash: [4, 3],
                            tension: 0.25,
                            borderWidth: 1.8,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    interaction: { mode: "index", intersect: false },
                    plugins: { legend: { labels: { boxWidth: 12 } } },
                    scales: {
                        x: { ticks: { maxTicksLimit: 9 } },
                        y: { position: "left" },
                        y1: { position: "right", grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            reloadAnalyticsCharts();

            window.addEventListener("agro:telemetry", function (e) {
                const t = e.detail;
                const selZone = parseInt(document.getElementById("an-zone-select").value, 10);
                if (!t || t.zoneId !== selZone || currentHours !== 1 || !tempChart || !vpdChart || !t.isSensorOnline) return;

                const lbl = new Date(t.recordedAtUtc).toLocaleTimeString("ru-RU");
                tempChart.data.labels.push(lbl);
                tempChart.data.datasets[0].data.push(t.temperatureC);
                tempChart.data.datasets[1].data.push(t.dewPointC);
                tempChart.data.datasets[2].data.push(tempChart.data.datasets[2].data[0]);
                tempChart.data.datasets[3].data.push(tempChart.data.datasets[3].data[0]);

                vpdChart.data.labels.push(lbl);
                vpdChart.data.datasets[0].data.push(t.humidityPercent);
                vpdChart.data.datasets[1].data.push(t.vpdKpa);
                vpdChart.data.datasets[2].data.push(+(t.co2Ppm / 10.0).toFixed(1));

                if (tempChart.data.labels.length > 90) {
                    tempChart.data.labels.shift();
                    tempChart.data.datasets.forEach(ds => ds.data.shift());
                    vpdChart.data.labels.shift();
                    vpdChart.data.datasets.forEach(ds => ds.data.shift());
                }

                tempChart.update("none");
                vpdChart.update("none");
            });
        });
    </script>
}
