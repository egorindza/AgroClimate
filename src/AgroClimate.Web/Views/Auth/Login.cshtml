@model IReadOnlyList<DemoRoles.DemoPersona>
@{
    ViewData["Title"] = "Выбор демо-роли специалиста";
    string returnUrl = ViewData["ReturnUrl"]?.ToString() ?? "/";
    string currentRole = User.GetRoleKey();
}

<header class="page-header">
    <div>
        <p class="eyebrow">Демонстрационный режим портфолио · вход в 1 клик</p>
        <h1>Выбор рабочей роли специалиста ИрГАУ</h1>
        <p class="page-description">Каждая роль определяет уровень полномочий в конструкторе агро-профилей (Temporal Tables), оперативной комнате Incident War Room и управлении ключами телеметрии ESP32, а также фиксируется в системном аудите.</p>
    </div>
</header>

<div class="row g-3">
    @foreach (var persona in Model)
    {
        bool isActive = persona.RoleKey == currentRole;
        <div class="col-lg-4">
            <div class="panel @(isActive ? "preview-highlight" : "") h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-2">
                        <span class="agro-badge @(isActive ? "" : "agro-badge-info")">
                            @(isActive ? "Активная сессия" : "Роль специалиста ИрГАУ")
                        </span>
                    </div>
                    <h2 class="h5 fw-bold mb-1">@persona.RoleTitle</h2>
                    <div class="fw-bold mb-1" style="color:var(--agro-primary);">@persona.FullName</div>
                    <div class="small text-muted mb-3">@persona.Department</div>
                    <p class="small text-muted mb-4">@persona.CapabilitiesSummary</p>
                </div>

                <form method="post" action="/Auth/SwitchRole" style="margin:0;">
                    <input type="hidden" name="roleKey" value="@persona.RoleKey" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn @(isActive ? "btn-outline-primary" : "btn-primary") w-100">
                        @(isActive ? $"Продолжить как {persona.FullName}" : $"Войти в 1 клик как {persona.FullName} →")
                    </button>
                </form>
            </div>
        </div>
    }
</div>
