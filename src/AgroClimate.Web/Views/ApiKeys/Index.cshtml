@model ApiKeysViewModel
@{
    ViewData["Title"] = "Шлюз ESP32 и API-ключи";
    string sampleKey = Model.SelectedSampleKey?.ApiKey ?? "IRGAU-ESP32-GH1-DEMO-2026";
    string sampleSensor = Model.SelectedSampleKey?.Zone?.ControllerNodeId ?? "ESP32-GH1-01";
    string sampleZoneName = Model.SelectedSampleKey?.Zone?.Name ?? "Теплица №1 — Рассада томата";

    var esp32Sketch = $$"""
#include <WiFi.h>
#include <HTTPClient.h>
#include <DHT.h>

const char* WIFI_SSID  = "IrGAU_AgroLab_IoT";
const char* WIFI_PASS  = "SiberiaAgro2026";
const char* SERVER_URL = "{{Model.BaseServerUrl}}/api/v1/telemetry/ingest";
const char* API_KEY    = "{{sampleKey}}";

DHT dht(4, DHT22);

void setup() {
  Serial.begin(115200);
  dht.begin();
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  while (WiFi.status() != WL_CONNECTED) { delay(500); }
}

void loop() {
  float temp = dht.readTemperature();
  float hum  = dht.readHumidity();
  int co2Ppm = 720; // SCD41 I2C NDIR датчик CO2

  if (!isnan(temp) && !isnan(hum) && WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(SERVER_URL);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("X-Api-Key", API_KEY);

    String payload = String("{\"sensorCode\":\"{{sampleSensor}}\",\"temperatureC\":")
                     + String(temp, 2) + ",\"humidityPercent\":" + String(hum, 1)
                     + ",\"co2Ppm\":" + String(co2Ppm) + "}";

    int statusCode = http.POST(payload);
    Serial.printf("[AgroClimate] HTTP %d -> %s\n", statusCode, http.getString().c_str());
    http.end();
  }
  delay(5000);
}
""";
}

<header class="page-header">
    <div>
        <p class="eyebrow">Аппаратная интеграция и телеметрический конвейер</p>
        <h1>Шлюз микроконтроллеров ESP32 / Arduino</h1>
        <p class="page-description">Приём JSON-пакетов от лабораторных и промышленных узлов по заголовку <code>X-Api-Key</code> с неблокирующей постановкой в <code>System.Threading.Channels</code> и пакетной записью <code>SqlBulkCopy</code>.</p>
    </div>
    <div class="header-actions">
        <a href="/api/v1/telemetry/pipeline" target="_blank" class="btn btn-outline-primary">JSON диагностика конвейера</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.CreatedMessage))
{
    <div class="alert alert-success" role="status">@Model.CreatedMessage</div>
}
@if (Model.ValidationErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert">@string.Join(" ", Model.ValidationErrors)</div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <p class="eyebrow mb-1">Управление доступом</p>
            <h2 class="h5 fw-bold mb-3">Выпуск API-ключа для студенческого / полевого узла</h2>
            <form method="post" action="/ApiKeys/Create">
                <div class="mb-3">
                    <label class="form-label">Маркировка микроконтроллера / стенда</label>
                    <input type="text" name="DeviceLabel" class="form-control" required
                           placeholder="Напр.: ESP32-C6 Стенд кафедры автоматизации №4" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Привязка к климатической зоне ИрГАУ</label>
                    <select name="ZoneId" class="form-select">
                        @foreach (var z in Model.Zones)
                        {
                            <option value="@z.Id">@z.Name (@z.Code)</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary" @(User.CanManageApiKeys() ? "" : "disabled")>
                    Сгенерировать ключ доступа
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel preview-highlight h-100">
            <p class="eyebrow mb-1">Интерактивная проверка шлюза</p>
            <h2 class="h5 fw-bold mb-2">Тестовая отправка пакета в <code>POST /api/v1/telemetry/ingest</code></h2>
            <p class="small text-muted mb-3">
                Выбранный ключ: <code>@sampleKey</code> (@sampleZoneName)
            </p>

            <div class="row g-2 mb-3">
                <div class="col-4">
                    <label class="form-label small">Температура (°C)</label>
                    <input type="number" step="0.1" id="test-temp" class="form-control tabular" value="23.4" />
                </div>
                <div class="col-4">
                    <label class="form-label small">Влажность (%)</label>
                    <input type="number" step="0.5" id="test-hum" class="form-control tabular" value="66.5" />
                </div>
                <div class="col-4">
                    <label class="form-label small">CO₂ (ppm)</label>
                    <input type="number" step="10" id="test-co2" class="form-control tabular" value="760" />
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" onclick="sendTestEspPacket()" class="btn btn-primary">
                    Отправить реальный HTTP POST пакет
                </button>
                <span id="test-api-status" class="small fw-semibold text-muted"></span>
            </div>

            <pre id="test-api-output" class="code-block mt-3" style="max-height:135px;display:none;"></pre>
        </div>
    </div>
</div>

<!-- Журнал выпущенных ключей -->
<section class="panel mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <p class="eyebrow mb-0">Реестр учётных данных</p>
            <h2 class="h5 fw-bold mb-0">Активные и отозванные API-ключи</h2>
        </div>
        <input type="search" class="form-control form-control-sm" style="width:250px;"
               placeholder="Фильтр по стенду или зоне…"
               data-table-filter="apiKeysRegistryTable" />
    </div>
    <div id="apikeys-table-host">
        @await Html.PartialAsync("_ApiKeysTable", Model.ApiKeys)
    </div>
</section>

<!-- Примеры кода -->
<div class="row g-3">
    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 fw-bold mb-0">Пример отправки через <code>curl</code></h2>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyCodeBlock('curl-snippet')">Скопировать</button>
            </div>
            <pre id="curl-snippet" class="code-block">curl -X POST "@Model.BaseServerUrl/api/v1/telemetry/ingest" \
  -H "Content-Type: application/json" \
  -H "X-Api-Key: @sampleKey" \
  -d '{
    "sensorCode": "@sampleSensor",
    "temperatureC": 22.8,
    "humidityPercent": 67.5,
    "co2Ppm": 740
  }'</pre>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 fw-bold mb-0">Готовый C++ скетч для ESP32 (Arduino IDE / PlatformIO)</h2>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyCodeBlock('esp32-sketch')">Скопировать скетч</button>
            </div>
            <pre id="esp32-sketch" class="code-block">@esp32Sketch</pre>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendTestEspPacket() {
            const statusEl = document.getElementById("test-api-status");
            const outEl = document.getElementById("test-api-output");
            statusEl.textContent = "Отправка пакета…";

            const body = {
                sensorCode: "@sampleSensor",
                temperatureC: parseFloat(document.getElementById("test-temp").value),
                humidityPercent: parseFloat(document.getElementById("test-hum").value),
                co2Ppm: parseFloat(document.getElementById("test-co2").value)
            };

            const resp = await fetch("/api/v1/telemetry/ingest", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Api-Key": "@sampleKey"
                },
                body: JSON.stringify(body)
            });

            const json = await resp.json();
            statusEl.textContent = `Ответ сервера: HTTP ${resp.status}`;
            statusEl.style.color = resp.ok ? "var(--agro-primary)" : "var(--agro-danger)";
            outEl.style.display = "block";
            outEl.textContent = JSON.stringify(json, null, 2);
        }

        function copyCodeBlock(id) {
            const el = document.getElementById(id);
            if (!el) return;
            navigator.clipboard.writeText(el.textContent);
        }
    </script>
}
