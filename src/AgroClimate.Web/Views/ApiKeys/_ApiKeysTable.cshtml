@model IReadOnlyList<ApiKeyCredential>

<div class="table-responsive">
    <table id="apiKeysRegistryTable" class="table table-sticky tabular">
        <thead>
            <tr>
                <th>Контроллер / Стенд</th>
                <th>Климатическая зона</th>
                <th>API-ключ (<code>X-Api-Key</code>)</th>
                <th>Принято пакетов</th>
                <th>Последний пакет</th>
                <th>Статус</th>
                <th class="text-end">Управление</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                <tr>
                    <td>
                        <strong>@k.DeviceLabel</strong><br />
                        <small class="text-muted">Выдал: @k.CreatedBy</small>
                    </td>
                    <td>@k.Zone?.Name</td>
                    <td><code>@k.ApiKey</code></td>
                    <td class="fw-bold">@k.TotalPacketsReceived.ToString("N0")</td>
                    <td class="small">
                        @(k.LastUsedAtUtc.HasValue ? k.LastUsedAtUtc.Value.AddHours(8).ToString("dd.MM HH:mm:ss") + " ИРК" : "Ожидает подключения")
                    </td>
                    <td>
                        @if (k.IsActive)
                        {
                            <span class="agro-badge">Активен</span>
                        }
                        else
                        {
                            <span class="agro-badge agro-badge-danger">Отозван</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a href="/ApiKeys?keyId=@k.Id" class="btn btn-outline-primary btn-sm">Скетч</a>
                        @if (User.CanManageApiKeys())
                        {
                            <button type="button"
                                    class="btn btn-sm ms-1 @(k.IsActive ? "btn-outline-secondary" : "btn-primary")"
                                    hx-post="/ApiKeys/Toggle/@k.Id"
                                    hx-target="#apikeys-table-host"
                                    hx-swap="innerHTML">
                                @(k.IsActive ? "Отозвать" : "Включить")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
